# Database
DATABASE_URL="postgresql://user:password@localhost:5432/billing_db?schema=public"

# JWT
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="1d"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_TLS=false

# SMTP (Email)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-user"
SMTP_PASS="your-pass"
SMTP_FROM="noreply@saas-billing.com"

# Stripe (Payments) - TEST KEYS ONLY
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_your_test_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# App
PORT=3001
FRONTEND_URL="http://localhost:3000"
TRUST_PROXY=false
LOG_FORMAT=pretty
NODE_ENV="development"

# Rate Limiting
# Webhook rate limit settings (requests per minute per tenant)
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_MAX_REQUESTS=100
